{
  "manifest_version": 3,
  "name": "Catra SoundCloud Downloader",
  "version": "0.3.4",
  "description": "Add download buttons to SoundCloud tracks via Catra desktop app",
  "host_permissions": ["http://127.0.0.1:17340/*"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["src/utils.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
