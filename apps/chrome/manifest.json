{
  "manifest_version": 3,
  "name": "Catra SoundCloud Downloader",
  "version": "0.2.0",
  "description": "Add download buttons to SoundCloud tracks via yt-dlp",
  "permissions": ["nativeMessaging"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://soundcloud.com/*"],
      "js": ["src/utils.js", "src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
